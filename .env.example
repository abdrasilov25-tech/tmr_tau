# Скопируй в .env и подставь свои значения. Файл .env не коммитить.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# OAuth (обязательно совпадает с Supabase → Authentication → URL Configuration)
# iOS: в Info.plist уже есть схема tmrtau — добавьте в Supabase Redirect URLs:
#   tmrtau://auth/callback
OAUTH_REDIRECT_TO=tmrtau://auth/callback

# Google: Web client + iOS client (Android привязан в консоли по package + SHA-1)
# iOS Client ID (Credentials → iOS): меняйте при смене клиента в Google Cloud.
GOOGLE_IOS_CLIENT_ID=214192616041-o55e942jj0kjs9g33om332loaeomsg0q.apps.googleusercontent.com
# Web application client ID — тот же, что в Supabase → Auth → Google (Client ID).
GOOGLE_WEB_CLIENT_ID=
# Секрет в приложение не кладём — только в Supabase (Google provider).
# Обязательно: у Web client в Google Cloud → Authorized redirect URIs добавьте
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# (именно /auth/v1/callback проекта Supabase — иначе ошибка 400 redirect_uri_mismatch).
# iOS client: bundle id приложения; в Supabase в провайдере Google укажите те же Client ID.

# --- In-App Purchase — секреты не в Flutter. Только Supabase → Edge Functions → Secrets ---
# В Dashboard проекта: Edge Functions → Secrets, или: supabase secrets set ...
# APPLE_SHARED_SECRET=...
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
# (SUPABASE_URL / SERVICE_ROLE подставляются в функциях автоматически)

# --- Прямой эфир (Agora) — https://console.agora.io/ ---
AGORA_APP_ID=
# Опционально: статический RTC Token из консоли Agora. Если пусто — клиент
# запросит токен у Edge Function agora-rtc-token (секреты AGORA_APP_CERTIFICATE в Supabase).
# Если App Certificate в Agora выключен — токен не нужен.
# AGORA_TOKEN=

